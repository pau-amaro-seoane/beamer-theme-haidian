%
% This style file provides a consistent, dark-themed Beamer template
% inspired by the Haidian district of Beijing. The Haidian district is 
% home to Peking University, the Kavli Institute for Astronomy and Astrophysics, 
% and the Beijing Institute of Mathematical Sciences and Applications (BIMSA).
%
% It is specifically designed for presentations on astrophysics, gravitational-wave
% physics, and related fields. The primary design philosophy focuses on 
% maximizing readability and reducing eye strain in low-light environments.
%
% Features:
%   - Black background with white and dimmed text for low-light environments.
%   - Custom \idea{} and \point{} commands for semantic highlighting of key concepts.
%   - A \plain{} slide environment for centering text with no headers or footers.
%   - A \plotslide{} command featuring a fade-in effect to mitigate sudden brightness jumps when displaying plots.
%   - A \plotslidecomment{} command that positions a figure at the top of the slide with compact, bulleted comments below it.
%   - A \slidemovie{} command for seamlessly embedding videos with static poster images.
%   - A custom \maketitle definition that removes navigation clutter from the title slide.
%
% Basic Usage Example:
%   To use this theme, simply include it in your preamble:
%   \documentclass{beamer}
%   \usepackage{beamerthemehaidian}
%   \begin{document}
%   \maketitle
%   \end{document}
%
% =============================================================================


% =============================================================================
% SECTION 1: PACKAGE REQUIREMENTS
% =============================================================================
% All external packages needed for this theme are loaded here.
% Ensure these packages are available in your LaTeX distribution.
% =============================================================================

% Color management: allows defining custom colors and color models.
\RequirePackage{xcolor}

% Font management: Cantarell is a clean, modern sans-serif font designed
% for readability on screens. The [default] option ensures it is set as the main font for the document.
\RequirePackage[default]{cantarell}

% Font encoding: ensures proper rendering of accented characters and
% special symbols (e.g., \ss, \"a, etc.).
\RequirePackage[T1]{fontenc}

% Graphics inclusion: provides \includegraphics for embedding external figures
% (such as PDF, PNG, or JPG files) into the presentation slides.
\RequirePackage{graphicx}

% List customization: provides \setlist and \newlist for fine-grained
% control over itemize/enumerate spacing and appearance.
% Note: Currently commented out to prevent conflicts with Beamer's native lists.
%\RequirePackage{enumitem}

% Multimedia embedding: provides the \movie command for embedding videos and audio
% directly into PDF presentations. This works optimally with viewers like Okular and Adobe Acrobat on Linux environments.
\RequirePackage{multimedia}


% =============================================================================
% SECTION 2: COLOR DEFINITIONS
% =============================================================================
% Custom colors used throughout the presentation theme.
% =============================================================================

% Define a slightly dimmed red for less eye strain.
% Standard red in the xcolor package is (1.0, 0.0, 0.0) in the RGB color model.
% This custom definition reduces the red channel to 0.85 (making it 15% dimmer) and adds a tiny bit
% of green (0.1) and blue (0.1) to make it less harsh on the eyes in a dark room.
% This specific color is utilized by the \point{} command for highlights and other emphasized text.
\definecolor{dimred}{rgb}{0.85, 0.1, 0.1}


% =============================================================================
% SECTION 3: BEAMER COLOR THEME
% =============================================================================
% Sets the color scheme for all major Beamer elements: background, text, titles,
% list items, and hyperlinks. Everything is designed for a dark background
% with high-contrast white or dimmed text to maintain readability in dark rooms.
% =============================================================================

% Background: set to solid black for maximum contrast and minimal light emission.
\setbeamercolor{background canvas}{bg=black}

% Text colors: set to white for standard body text, frame titles, and list items.
\setbeamercolor{normal text}{fg=white}
\setbeamercolor{frametitle}{fg=white, bg=black}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=white}
\setbeamercolor{item}{fg=white}
\setbeamercolor{subitem}{fg=white}

% Hyperlinks: set to white for internal document links (e.g., section references),
% and dimred for external URLs to subtly distinguish them from internal links without distracting the audience.
\hypersetup{colorlinks=true, linkcolor=white, urlcolor=dimred}


% =============================================================================
% SECTION 4: BEAMER TEMPLATES
% =============================================================================
% Customizes the visual appearance of various structural Beamer elements: navigation symbols,
% frame titles, and bullet styles. These form the visual building blocks of every slide.
% =============================================================================

% Remove navigation symbols (the small interactive icons usually found at the bottom of each slide)
% to create a clean, distraction-free layout. In a live presentation, these are
% rarely needed and generally only add visual clutter to the screen.
\setbeamertemplate{navigation symbols}{}

% Custom frame title template:
%   - Adds a small vertical space (0.2cm) above the title to provide breathing room.
%   - Displays the title using the current font and color settings.
%   - Draws a thin red horizontal rule (0.5pt thick) below the title for visual separation.
%   - The red line acts as a subtle delimiter separating the title from the slide content.
\setbeamertemplate{frametitle}{%
  \vspace{0.2cm}%
  \usebeamerfont{frametitle}%
  \usebeamercolor[fg]{frametitle}%
  \insertframetitle\par%
  \vspace{0.05cm}%
  {\color{red}\rule{\textwidth}{0.5pt}}%
  \vspace{0.05cm}%
}

% Override the default circular bullets by using square bullets for itemize lists.
% Square bullets provide a cleaner, more modern aesthetic and are functionally
% less visually prominent than circles, which helps reduce audience distraction.
\setbeamertemplate{itemize items}[square]


% =============================================================================
% SECTION 5: GLOBAL ITEMIZE SPACING
% =============================================================================
% This section introduces extra vertical spacing between items in ALL standard itemize environments
% to improve overall readability. The \AddToHook command utilized here is the modern LaTeX method for
% automatically inserting code after an environment ends.
%
% IMPORTANT NOTE: This spacing application applies to ALL \begin{itemize}...\end{itemize} blocks.
% It intentionally does NOT apply to the custom figcommentlist environment, which maintains its own tight spacing
% defined explicitly in Section 6.
% =============================================================================

% After every itemize environment initializes, add 0.5cm of vertical space between the items.
% This makes multi-item lists significantly more readable by providing clear visual
% separation between distinct bullet points.
%
% Note: This represents the "relaxed" spacing style for regular text slides. The figcommentlist
%       environment used within \plotslidecomment utilizes much tighter spacing (see Section 6).
\AddToHook{cmd/itemize/after}{%
  \addtolength{\itemsep}{0.5cm}%
}

% ===========================================
% SECTION 6: CUSTOM LIST FOR FIGURE COMMENTS
% ===========================================
% Defines a custom environment specifically designed for annotating figures compactly.
% The \ifdefined check prevents LaTeX errors if the style file happens to be loaded multiple times.
\ifdefined\figcommentlist\else
  \newenvironment{figcommentlist}{%
    \begin{itemize}%
      % These lengths override the global relaxed spacing to create a dense, compact list.
      \setlength{\itemsep}{2pt}%
      \setlength{\parsep}{2pt}%
      \setlength{\topsep}{2pt}%
      \setlength{\partopsep}{0pt}%
      \setlength{\leftmargin}{1.5em}%
    }{%
    \end{itemize}%
  }
\fi

% =============================================================================
% SECTION 7: CUSTOM COMMANDS FOR PRESENTATION CONTENT
% =============================================================================
% These custom commands provide semantic markup options for presentation content,
% which makes the underlying source code more readable and ensures slide styling remains consistent.
% =============================================================================

% \idea{text}
%   Purpose: Wraps regular slide content without applying any additional formatting.
%   It is designed to be used alongside the \point{} command to cleanly separate the main idea from the key takeaway.
%   This creates a clean, logical semantic distinction directly in the source code:
%     \idea{This is the main idea.} \point{This is the punchline.}
%
%   The deliberate lack of formatting is intentional: it keeps the audience focus squarely on the content
%   and allows the accompanying \point{} text to stand out effectively.
%
%   Example:
%   \idea{The simulation reached a steady state.} \point{Energy is conserved.}
\newcommand{\idea}[1]{#1}

% \point{text}
%   Purpose: Highlights the key insight or textual punchline by styling it in dimred italic.
%   Used specifically to emphasize the single most important takeaway from any given slide.
%   The unique combination of the dimred color and italicized font draws the eye naturally without
%   being visually jarring or distracting to the viewer.
%
%   Usage Rule: It should always be paired with the \idea{} command to maintain a clear "idea → punchline" structure.
\newcommand{\point}[1]{%
  \textcolor{dimred}{\textit{#1}}%
}

% \plain{text}
%   Purpose: Generates a minimal, distraction-free slide displaying only centered text.
%   It automatically removes all standard headers, footers, and navigation elements.
%
%   Ideal Use Cases:
%     - Section breaks (e.g., "Part I: Introduction")
%     - Emphasis quotes (e.g., "The Moon changes everything")
%     - Transitional statements (e.g., "Let's now consider the implications")
%
%   The provided text is rendered in Large bold font to maximize impact without introducing visual clutter.
%
%   Example:
%   \plain{Part II: Gravitational Wave Detection}
\newcommand{\plain}[1]{%
  \begin{frame}[plain]
    \centering
    \vspace*{\fill}
    {\Large \textbf{#1}}
    \vspace*{\fill}
  \end{frame}
}


% =============================================================================
% SECTION 8: PLOT SLIDES (NO COMMENTS)
% =============================================================================
% \plotslide[options]{filename}
%   Purpose: Renders a single plot at full slide size accompanied by a gentle fade-in transition.
%   The provided plot is perfectly centered both vertically and horizontally on the slide.
%
%   The built-in 1.5-second fade transition specifically mitigates the abrupt brightness jump that occurs when switching from a black
%   slide to a bright plot, allowing the audience's eyes time to comfortably adapt.
%
%   Options: Accepts any standard beamer frame options (e.g., <+-> for staggered overlays).
%   Filename: The relative or absolute path to an image file (supports PDF, PNG, JPG, etc.).
%
%   Usage Examples:
%     \plotslide{figures/violin_plots.pdf}
%     \plotslide[<+->]{figures/animation.pdf}  % Incorporates an overlay specification
% =============================================================================
\newcommand{\plotslide}[2][]{%
  \begin{frame}[plain,#1]
    \transfade[duration=1.5]
    \centering
    \vspace*{\fill}
    \includegraphics[width=0.9\textwidth,height=0.8\textheight,keepaspectratio]{#2}
    \vspace*{\fill}
  \end{frame}
}


% =============================================================================
% SECTION 9: PLOT SLIDES WITH COMMENTS
% =============================================================================
% \plotslidecomment[options]{filename}{comment1}{comment2}{comment3}{comment4}
%   Purpose: Displays a plot at the upper section of the slide accompanied by compact bullet
%            comments situated directly below it. The figure is intentionally moved to the top of the frame to maximize
%            overall visibility while still leaving room to provide necessary context.
%
%   The included comments utilize the custom figcommentlist environment (detailed in Section 6) which features tight spacing,
%   ensuring that the text does not waste valuable vertical slide space.
%
%   Empty text arguments are automatically detected and ignored, allowing you to seamlessly provide 1, 2, 3, or up to 4
%   comments without inadvertently rendering blank bullet points.
%
%   Options: Accepts any standard beamer frame options (e.g., <+-> for overlays).
%   Filename: The relative or absolute path to an image file (supports PDF, PNG, JPG, etc.).
%   comment1-4: Allows for up to four distinct bullet points of text annotation.
%
%   Usage Examples:
%     \plotslidecomment{figures/plot.pdf}{First observation comment}{}{}{}
%     \plotslidecomment{figures/plot.pdf}{First observation}{Second observation}{}{}
%     \plotslidecomment{figures/plot.pdf}{First observation}{Second observation}{Third observation}{}
%     \plotslidecomment{figures/plot.pdf}{First observation}{Second observation}{Third observation}{Fourth observation}
%
%   Technical implementation note: The underlying LaTeX command takes exactly 6 arguments:
%     #1 = optional frame options
%     #2 = filename
%     #3 = first comment
%     #4 = second comment
%     #5 = third comment
%     #6 = fourth comment
% =============================================================================
\newcommand{\plotslidecomment}[6][]{%
  \begin{frame}[plain,#1]
    \transfade[duration=1.5]
    \centering
    \vspace{0.2cm}
    \includegraphics[width=0.9\textwidth,height=0.6\textheight,keepaspectratio]{#2}
    \vspace{0.1cm}
    \def\a{#3}\def\b{#4}\def\c{#5}\def\d{#6}%
    \ifx\a\empty\else{%
      \scriptsize\color{white}%
      \begin{figcommentlist}
        \item #3%
        \ifx\b\empty\else\item #4\fi
        \ifx\c\empty\else\item #5\fi
        \ifx\d\empty\else\item #6\fi
      \end{figcommentlist}%
    }\fi
    \vspace*{\fill}
  \end{frame}
}


% =============================================================================
% SECTION 10: MOVIE SLIDE
% =============================================================================
% \slidemovie[options]{filename}{poster}{caption}
%   Purpose: Embeds a playable video directly within a slide and displays a preview image (known as a poster).
%   Clicking the static poster image during the presentation initiates video playback. The provided caption string appears centered below the media.
%
%   Package Requirement: This feature relies on \RequirePackage{multimedia} (which is loaded in Section 1).
%   Compatibility Note: On Linux operating systems, use viewers like Okular or Adobe Acrobat to ensure best playback results.
%
%   Options: Accepts any configuration options recognized by the \movie command (such as width, height, poster, etc.).
%   filename: The target video file (e.g., simulation_movie.mp4).
%   poster:   A static image file displayed on the slide before playback is initiated (e.g., first_frame.png).
%   caption:  The descriptive text displayed immediately below the movie frame.
%
%   Pro-tip: You can extract a suitable poster frame directly from your video file using ffmpeg:
%     ffmpeg -i movie.mp4 -vframes 1 poster.png
%
%   Usage Examples:
%     \slidemovie{animation.mp4}{poster.png}{Precession of the rotation axis.}
%     \slidemovie[width=0.95\textwidth,height=0.8\textheight]{movie.mp4}{poster.png}{Caption text describing the footage}
% =============================================================================
\newcommand{\slidemovie}[4][]{%
  \begin{frame}[plain]
    \transfade[duration=1.5]
    \centering
    \vspace*{\fill}
    \movie[#1]{%
      \includegraphics[width=0.9\textwidth,height=0.7\textheight,keepaspectratio]{#3}%
    }{#2}%
    \par\vspace{0.3cm}
    {\small \color{white}#4}
    \vspace*{\fill}
  \end{frame}
}


% =============================================================================
% SECTION 11: CUSTOM TITLE PAGE
% =============================================================================
% Redefines the standard \maketitle command to generate a clean, perfectly centered title slide devoid of
% any navigation clutter. The presentation title is output in a LARGE bold font size,
% and the author's name appears directly below it separated by a small vertical gap.
%
% The textual contents for the title and author are populated using the standard Beamer \title{} and \author{}
% preamble commands. The presentation date is intentionally omitted by default to ensure a cleaner aesthetic (though you can explicitly use \date{} if it is strictly needed).
%
% Usage Example:
%   In your main document preamble:
%   \title{Extreme-Mass-Ratio Inspirals}
%   \author{Dr. Pau Amaro Seoane}
%   Inside your document environment:
%   \maketitle
% =============================================================================

\makeatletter
\def\maketitle{%
  \begin{frame}[plain]
    \centering
    \vspace*{\fill}
    {\LARGE \bf \inserttitle}\\%
    \vspace{1cm}
    {\insertauthor}%
    \vspace*{\fill}
  \end{frame}
}
\makeatother


